{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-solve.github.io/schemas/v1/profile.schema.json",
  "title": "Research profile",
  "description": "profiles/<id>.yaml. Profiles are distinct from disciplines (§4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "applies_to", "description"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["attempt", "counterexample", "correction", "review", "author_response", "replication", "legacy_record"]}
    },
    "description": {"$ref": "common.schema.json#/$defs/long_text"}
  }
}
