{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-solve.github.io/schemas/v1/artifact-record.schema.json",
  "title": "Artifact record (ledger)",
  "description": "One stored, released or linked artifact version. Renderer outputs also record the source fingerprint and toolchain (§4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "artifact_version", "role", "logical_path", "media_type", "digest",
    "bytes", "rights", "provenance", "availability", "locations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "role": {
      "enum": [
        "manuscript", "manuscript_source", "bibliography", "figure", "data", "supplementary", "transcript",
        "formal_proof", "code", "notebook", "model", "dataset", "rendering", "package"
      ]
    },
    "logical_path": {"type": "string", "minLength": 1, "maxLength": 255},
    "media_type": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$", "maxLength": 100},
    "digest": {
      "description": "Null only for an external artifact the platform has not examined.",
      "anyOf": [{"$ref": "common.schema.json#/$defs/digest"}, {"type": "null"}]
    },
    "bytes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "rights": {"$ref": "common.schema.json#/$defs/rights"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {"enum": ["contributor", "platform_renderer", "platform_packager", "legacy_import"]},
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "source_fingerprint"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 100},
            "version": {"type": "string", "minLength": 1, "maxLength": 100},
            "image_digest": {"$ref": "common.schema.json#/$defs/digest"},
            "source_fingerprint": {"$ref": "common.schema.json#/$defs/digest"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"enum": ["platform_renderer", "platform_packager"]}}, "required": ["origin"]},
          "then": {"required": ["renderer"]},
          "else": {"not": {"required": ["renderer"]}}
        }
      ]
    },
    "availability": {"enum": ["available", "unavailable", "withdrawn", "tombstoned"]},
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repository", "commit", "path"],
            "properties": {
              "kind": {"const": "in_repository"},
              "repository": {"$ref": "common.schema.json#/$defs/repository"},
              "commit": {"$ref": "common.schema.json#/$defs/git_sha"},
              "path": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "repository", "release_tag", "asset_name"],
            "properties": {
              "kind": {"const": "release_asset"},
              "repository": {"$ref": "common.schema.json#/$defs/repository"},
              "release_tag": {"type": "string", "minLength": 1, "maxLength": 200},
              "asset_name": {"type": "string", "minLength": 1, "maxLength": 255},
              "asset_id": {"type": "integer", "minimum": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url", "pin"],
            "properties": {
              "kind": {"const": "external_pinned"},
              "url": {"$ref": "common.schema.json#/$defs/https_url"},
              "pin": {"$ref": "common.schema.json#/$defs/pin"}
            }
          }
        ]
      }
    }
  }
}
