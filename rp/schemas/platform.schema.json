{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-solve.github.io/schemas/v1/platform.schema.json",
  "title": "Platform settings",
  "description": "policies/platform.yaml: organisation, repositories and the owner decisions of §13.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "organisation", "site", "repositories", "staging", "legacy", "policy_version",
    "licences", "budget", "screening_enabled", "analytics", "allowed_external_hosts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "organisation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "discipline_sections"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https://[a-z0-9.-]+/$"},
        "discipline_sections": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/slug"}}
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "research"],
      "properties": {
        "platform": {"$ref": "common.schema.json#/$defs/repository"},
        "research": {"$ref": "common.schema.json#/$defs/repository"}
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organisation"],
      "properties": {"organisation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"}}
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "audited_commit"],
      "properties": {
        "repository": {"$ref": "common.schema.json#/$defs/repository"},
        "audited_commit": {"$ref": "common.schema.json#/$defs/git_sha"}
      }
    },
    "policy_version": {"$ref": "common.schema.json#/$defs/policy_version"},
    "licences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscripts", "software"],
      "properties": {
        "manuscripts": {"$ref": "common.schema.json#/$defs/spdx_expression"},
        "software": {"$ref": "common.schema.json#/$defs/spdx_expression"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "monthly_cap", "newcomer_daily_pool"],
      "properties": {
        "currency": {"const": "USD"},
        "monthly_cap": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "newcomer_daily_pool": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
      }
    },
    "screening_enabled": {"type": "boolean"},
    "subscription_fallback_enabled": {"type": "boolean"},
    "analytics": {"const": "none"},
    "allowed_external_hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["github", "hugging_face", "zenodo", "software_heritage"]}
    }
  }
}
