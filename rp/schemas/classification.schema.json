{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-solve.github.io/schemas/v1/classification.schema.json",
  "title": "Classification vocabulary",
  "description": "policies/classifications/<scheme>.yaml: top-level codes of a classification scheme.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scheme", "name", "source_note", "top_level_length", "top_level_codes"],
  "properties": {
    "schema_version": {"const": 1},
    "scheme": {"$ref": "common.schema.json#/$defs/slug"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_note": {"$ref": "common.schema.json#/$defs/short_text"},
    "top_level_length": {"type": "integer", "minimum": 1, "maximum": 8},
    "top_level_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]{1,8}$"}
    }
  }
}
