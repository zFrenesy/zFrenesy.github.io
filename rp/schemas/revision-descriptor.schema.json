{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-solve.github.io/schemas/v1/revision-descriptor.schema.json",
  "title": "Trusted revision descriptor (ledger)",
  "description": "Written only by the controller, and only after the referenced commits exist (§4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revision_id", "contribution_id", "predecessor", "sequence_label", "scientific_fingerprint",
    "scientific_metadata_digest", "artifact_manifest", "target_statement_revisions", "intake_refs",
    "candidate_head_sha", "merged_source_commit", "policy_version", "rubric_version", "review_context_digest",
    "authorised_actor", "linked_events", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revision_id": {"$ref": "common.schema.json#/$defs/revision_id"},
    "contribution_id": {"$ref": "common.schema.json#/$defs/contribution_id"},
    "predecessor": {"anyOf": [{"$ref": "common.schema.json#/$defs/revision_id"}, {"type": "null"}]},
    "sequence_label": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "scientific_fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
    "scientific_metadata_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "artifact_manifest": {"type": "array", "maxItems": 400, "items": {"$ref": "common.schema.json#/$defs/manifest_entry"}},
    "target_statement_revisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem_id", "statement_revision_id"],
        "properties": {
          "problem_id": {"$ref": "common.schema.json#/$defs/problem_id"},
          "statement_revision_id": {"$ref": "common.schema.json#/$defs/statement_revision_id"}
        }
      }
    },
    "intake_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "repository"],
        "properties": {
          "kind": {"enum": ["issue", "pull_request", "fork_pull_request", "cli_submission", "legacy_import"]},
          "repository": {"$ref": "common.schema.json#/$defs/repository"},
          "number": {"type": "integer", "minimum": 1},
          "url": {"$ref": "common.schema.json#/$defs/https_url"},
          "actor_github_id": {"$ref": "common.schema.json#/$defs/github_id"},
          "actor_login": {"$ref": "common.schema.json#/$defs/github_login"}
        }
      }
    },
    "candidate_head_sha": {"$ref": "common.schema.json#/$defs/git_sha"},
    "merged_source_commit": {"$ref": "common.schema.json#/$defs/git_sha"},
    "policy_version": {"$ref": "common.schema.json#/$defs/policy_version"},
    "rubric_version": {"$ref": "common.schema.json#/$defs/rubric_version"},
    "review_context_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "authorised_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person_ref", "github_id", "login_at_event", "editor_state_digest"],
      "properties": {
        "person_ref": {"$ref": "common.schema.json#/$defs/person_id"},
        "github_id": {"$ref": "common.schema.json#/$defs/github_id"},
        "login_at_event": {"$ref": "common.schema.json#/$defs/github_login"},
        "editor_state_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "linked_events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/event_id"}
    },
    "recorded_at": {"$ref": "common.schema.json#/$defs/utc_instant"}
  }
}
